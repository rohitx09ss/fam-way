# --- Database (Neon) ---
# Paste the Neon connection string. postgres:// is auto-converted. Keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Auth / secrets (generate long random values) ---
JWT_SECRET=change-me-long-random
# Fernet key for encrypting merchants' Gmail app passwords:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
ALLOW_SIGNUP=false

# --- CORS: your two Vercel URLs (comma separated) ---
FRONTEND_ORIGINS=https://your-merchant-panel.vercel.app,https://your-admin-panel.vercel.app

# --- Internal verify endpoint secret ---
WORKER_SHARED_SECRET=change-me-too

# --- Payment behaviour ---
QR_EXPIRY_SECONDS=300
MATCH_GRACE_SECONDS=30
ALLOW_UNIQUE_AMOUNT_MATCH=true
REQUIRE_EMAIL_AUTH=true
# FamPay's official sender address. Only mail from here is ever processed. Comma-separate if several.
FAMPAY_OFFICIAL_SENDERS=no-reply@famapp.in
IMAP_POLL_SECONDS=20
RUN_WORKERS=true

# --- Independent verification adapter: none | http ---
VERIFICATION_ADAPTER=none
VERIFICATION_API_URL=
VERIFICATION_API_KEY=
